      "interaction": "find_object",
      "hint": "Encuentra el objeto escondido.",
      "music": "music-home.mp3",
      "narration": "escena-026.mp3"
    },
    {
      "id": "027",
      "text": [
        "La puerta de la casa era límite",
        "de lo que se le permitía.",
        "Era mejor no salir",
        "y hacer caso a sus humanos."
      ],
      "background": "background-13.png",
